# AEGIS LOOP v2. Copy to .env; fill the blank values yourself.
# Never commit .env. Foundry is the offensive model; the target model stays local.

# Platform access. Use a long random value (at least 32 characters).
AEGIS_ADMIN_TOKEN=
# Optional Fernet key for evaluator-at-rest encryption. If blank, a persistent
# key is generated in .runtime/vault.key. Keep that file with database backups.
AEGIS_VAULT_KEY=
AEGIS_DATABASE_URL=sqlite:///./data/aegis.db
AEGIS_WORKERS=2
AEGIS_LEASE_SECONDS=90
AEGIS_COOKIE_SECURE=false
AEGIS_SESSION_HOURS=8
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Offensive provider: foundry | azure_openai | openai_compatible
AEGIS_RED_PROVIDER=foundry
# Foundry: https://YOUR-RESOURCE.services.ai.azure.com/models
# Foundry OpenAI v1: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Keep provider=foundry for v1; its requests omit the dated api-version query.
# Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com
AEGIS_RED_ENDPOINT=
AEGIS_RED_API_KEY=
AEGIS_RED_MODEL=
# Required only for azure_openai.
AEGIS_RED_DEPLOYMENT=
AEGIS_RED_API_VERSION=2024-05-01-preview
AEGIS_RED_TIMEOUT_SECONDS=45
AEGIS_RED_MAX_OUTPUT_TOKENS=1200

# Local OpenAI-compatible target (Ollama, llama.cpp, vLLM, LM Studio).
# This is a default for Target Setup; each registered target has its own revision.
AEGIS_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1
AEGIS_LOCAL_MODEL=
AEGIS_LOCAL_API_KEY=
AEGIS_LOCAL_ALLOWED_HOSTS=127.0.0.1,localhost,::1,host.docker.internal
AEGIS_TARGET_TIMEOUT_SECONDS=45
AEGIS_TARGET_MAX_OUTPUT_TOKENS=800

# Independent optional semantic judge. Without this connection, semantic-only
# cases remain inconclusive; deterministic retrieval/tool/canary/schema tests work.
AEGIS_JUDGE_PROVIDER=foundry
AEGIS_JUDGE_ENDPOINT=
AEGIS_JUDGE_API_KEY=
AEGIS_JUDGE_MODEL=
AEGIS_JUDGE_DEPLOYMENT=
AEGIS_JUDGE_API_VERSION=2024-05-01-preview

# Web proxy to the platform API. Used by Next.js on the server, not the browser.
AEGIS_API=http://127.0.0.1:8000

# Optional Docker/PostgreSQL deployment. Not required for Windows/SQLite.
AEGIS_POSTGRES_PASSWORD=
