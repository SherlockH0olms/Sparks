# ============================================================
# AEGIS LOOP — Attacker Model Bağlantısı (env dosyası)
# ============================================================
# Bu dosyayı kopyala: cp .env.example .env
# Sonra aşağıdaki 3 değeri doldur (gerçek anahtarları yaz).
# .env dosyası .gitignore'da zaten var - repoya ASLA girmez.
# ============================================================

# --- ZORUNLU: 3 alan ----------------------------------------

# Foundry endpoint adresin (OpenAI-uyumlu base URL)
# Örnek: https://xxx.foundry.azure.com/v1  veya  https://xxx.openai.azure.com/openai/v1
AEGIS_LLM_BASE_URL=https://huseynqemberli21-7475-resource.services.ai.azure.com/openai/v1

# API anahtarın
AEGIS_LLM_API_KEY=BhiRonI4sLwkNuBW2eTskHN7Az23snceT8BAE3wk6AGbb5337aktJQQJ99CIACYeBjFXJ3w3AAAAACOGWU2r

# Model adı (Foundry'de deployment/model adın ne ise aynen)
# Örnek: gpt-4o-mini, qwen2.5-7b-instruct, my-red-teamer-deploy vb.
AEGIS_LLM_MODEL=FW-GLM-5.3

# --- OPSİYONEL: ayarlanabilir (boş bırakırsan varsayılan) ---

# Üretici sıcaklığı (saldırı çeşitliliği; 0.7-1.2 arası önerilir)
AEGIS_LLM_TEMPERATURE=1.0

# Zaman aşımı (saniye) — model yavaşsa artır
AEGIS_LLM_TIMEOUT=30

# AEGIS'in saldırı üretiminde LLM'i kullanması (false → statik kütüphane)
AEGIS_USE_LLM_GENERATOR=true

# --- BİLGİ (elle değiştirme) --------------------------------
# openai-uyumlu /chat/completions çağrısı yapılır:
#   POST {AEGIS_LLM_BASE_URL}/chat/completions
#   Authorization: Bearer {AEGIS_LLM_API_KEY}
#   {"model": AEGIS_LLM_MODEL, "messages": [...], "temperature": ...}
#
# Foundry'de endpoint farklıysa (ör. /v1/chat/completions zaten base'e
# dahilse) base URL'yi öyle ver ki AEGIS sadece /chat/completions eklesin.
